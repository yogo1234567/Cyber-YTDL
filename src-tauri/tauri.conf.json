{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyber-YTDL",
  "version": "0.1.2",
  "identifier": "com.cairen.cyberytdl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cyber-ytdl",
        "width": 940,
        "height": 740,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "center": true,
        "visible": true,
        "dragDropEnabled": false,
        "contentProtected": false,
        "hiddenTitle": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "TradChinese",
          "English"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}